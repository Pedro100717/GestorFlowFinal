<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Adiciona campos extra automaticamente, como o nome da app -->
            <customFields>{"app":"GestorFlow", "env":"production"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE_JSON" />
    </root>

    <!-- Define o nível de detalhe para o teu próprio código -->
    <logger name="pt.gestorflow" level="DEBUG" />
</configuration>